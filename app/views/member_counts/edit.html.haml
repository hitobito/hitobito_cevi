- title t('.title', year: @year)

= form_for(@group, url: group_member_counts_path(@group), method: :put, builder: StandardFormBuilder) do |f|
  = hidden_field_tag(:year, @year)
  = form_buttons(f, submit_label: nil, cancel_url: census_group_group_path(@group, year: @year))

  .nested-form{data: { controller: 'nested-form', 'nested-form-assoc-value': 'current_member_counts' }}
    = render layout: 'member_counts/table_header', locals: { before_columns: %w(Jahrgang), id: 'current_member_counts_fields'} do
      = f.fields_for :current_member_counts, include_id: false do |mcf|
        = render 'member_counts/fields', f: mcf
      %tr{hidden: true, data: { 'nested-form-target': 'target' }}
    .controls
      %p
        = link_to 'Eintrag hinzufügen', 'javascript:void(0)', class: 'text', data: { action: 'nested-form#add' }
      %template{data: { 'nested-form-target': 'template' }}
        = f.fields_for :current_member_counts, MemberCount.new, child_index: 'NEW_CURRENT_MEMBER_COUNTS_RECORD', include_id: false do |mcf|
          = render 'member_counts/fields', f: mcf

  = form_buttons(f, submit_label: nil, cancel_url: census_group_group_path(@group, year: @year))
