%tr.fields
  %td
    - if f.object.new_record?
      = f.input_field :born_in, class: 'span1'
    - else
      = f.hidden_field :id
      %span.pe-2= format_member_count_born_in(f.object)
  %td= f.input_field :person_f
  %td= f.input_field :person_m
